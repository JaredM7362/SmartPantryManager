<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for a single row in the pantry list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Name and quantity stack vertically and take all remaining width. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="Tomatoes"
             />

        <TextView
            android:id="@+id/textItemQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="500 g"
            />

        <TextView
            android:id="@+id/textExpiryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnError"
            android:background="?attr/colorError"
            android:visibility="gone"
            tools:text="Expires soon" />
    </LinearLayout>

    <TextView
        android:id="@+id/textItemExpiry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="2026-09-10"
         />

</LinearLayout>